# ===== Marketing MAI settings =====
# Copy to ".env" (scripts/setup.sh does this). Paste your keys after the = signs.
# Never share .env or paste keys in chat.

# ---- AI brain (YOU fill these) ----
# REQUIRED — free, no card: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# RECOMMENDED backup — free, no card: https://console.groq.com → API Keys
GROQ_API_KEY=
# OPTIONAL — free 50 requests/day: https://openrouter.ai → Keys
OPENROUTER_API_KEY=
# The video team's script engine (Nemotron on OpenRouter) may give each of its five agents a key of its own.
# An agent without one uses OPENROUTER_API_KEY. Keys of one OpenRouter account share one daily limit.
OPENROUTER_KEY_EVIDENCE=
OPENROUTER_KEY_WRITER=
OPENROUTER_KEY_EDITOR=
OPENROUTER_KEY_LOOKBOOK=
OPENROUTER_KEY_VIDEO_PROMPT=
# NVIDIA (build.nvidia.com): free, about 40 requests a minute
NVIDIA_API_KEY=
# Token Harbor (tokenharbor.ai): free DeepSeek V4.1 Flash, Qwen3.8 Flash, MiMo V2.6 Flash
TOKENHARBOR_API_KEY=
# OPTIONAL extra free brains: https://cloud.cerebras.ai and https://console.mistral.ai
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# OPTIONAL: xAI Grok (https://console.x.ai) - only if your account has free credits
XAI_API_KEY=

# ---- Social media reading (YOU fill this) ----
# Free monthly credit: https://apify.com -> Settings -> API & Integrations -> Personal API token
APIFY_API_TOKEN=

# Model names (checked against your key by the dashboard)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GROQ_MODEL=openai/gpt-oss-120b

# ---- Manager approval (YOU fill these) ----
MANAGER_NAME=
MANAGER_EMAIL=
# Company Gmail + app password (Google Account → Security → App passwords) for the 6 PM email
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---- Internal service passwords (generated automatically by setup) ----
SEARXNG_SECRET=
CRAWL4AI_API_TOKEN=
HERMES_API_KEY=
MCP_TOKEN=

# ---- GPT Researcher (agents 06 + 08) ----
GOOGLE_API_KEY=${GEMINI_API_KEY}
FAST_LLM=google_genai:gemini-flash-lite-latest
SMART_LLM=google_genai:gemini-3.8-flash
STRATEGIC_LLM=google_genai:gemini-3.8-flash
RETRIEVER=searx
SEARX_URL=http://searxng:8080
DOC_PATH=/app/data/research_docs
TOTAL_WORDS=1300
LANGUAGE=english

# ---- Cognee (agent 05, the learning engine) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.8-flash
LLM_API_KEY=${GEMINI_API_KEY}
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
DB_PROVIDER=postgres
DB_HOST=host.docker.internal
DB_PORT=54322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cognee_db
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_HOST=host.docker.internal
VECTOR_DB_PORT=54322
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=postgres
VECTOR_DB_NAME=cognee_db
ENABLE_BACKEND_ACCESS_CONTROL=false
SYSTEM_ROOT_DIRECTORY=/app/data/cognee_system
DATA_ROOT_DIRECTORY=/app/data/cognee_data
TELEMETRY_DISABLED=1
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=10
LLM_RATE_LIMIT_INTERVAL=60

# Public web address (docker-compose.public.yml): login password, cookie signing secret, host name
DASHBOARD_PASSWORD=
SESSION_SECRET=
PUBLIC_HOST=

# Bloom (trybloom.ai): brand creative direction, read as context only
BLOOM_API_KEY=
BLOOM_BRAND_ID=
