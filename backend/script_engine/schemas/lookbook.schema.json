{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lookbook",
  "description": "Phase 2 of the Magppie Video Production Rules (Rule 5): what the finished film should look like, for a person to approve before any video prompt is written. It never restates or changes the locked script.",
  "type": "object",
  "required": [
    "lookbook_id",
    "run_id",
    "request_id",
    "version",
    "film_overview",
    "continuity_bible",
    "scenes",
    "product_moment",
    "sound_direction"
  ],
  "properties": {
    "lookbook_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "film_overview": {
      "type": "object",
      "required": [
        "title",
        "duration_seconds",
        "scene_count",
        "platform",
        "aspect_ratio",
        "one_line_story",
        "mood_words",
        "colour_palette",
        "typography",
        "overall_visual_language"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 30
        },
        "scene_count": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "type": "string"
        },
        "aspect_ratio": {
          "type": "string"
        },
        "one_line_story": {
          "type": "string",
          "minLength": 2
        },
        "mood_words": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "colour_palette": {
          "type": "array",
          "minItems": 5,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "name",
              "hex",
              "use"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "use": {
                "type": "string",
                "minLength": 2
              }
            },
            "additionalProperties": false
          }
        },
        "typography": {
          "type": "string",
          "minLength": 2,
          "description": "Direction for overlays, which are added in the edit."
        },
        "overall_visual_language": {
          "type": "string",
          "minLength": 2
        }
      },
      "additionalProperties": false
    },
    "continuity_bible": {
      "type": "object",
      "description": "The locked script's Continuity Bible as reviewable cards. A representation, never a second, different bible.",
      "required": [
        "character_cards",
        "set_card",
        "lighting_card",
        "colour_grade_card",
        "camera_language_card",
        "product_card"
      ],
      "properties": {
        "character_cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "continuity_id",
              "identity",
              "appearance",
              "wardrobe",
              "hair",
              "physical_continuity",
              "behavioural_continuity"
            ],
            "properties": {
              "continuity_id": {
                "type": "string",
                "pattern": "^C\\d+$",
                "description": "The character's ID in the locked Continuity Bible."
              },
              "identity": {
                "type": "string",
                "minLength": 2
              },
              "appearance": {
                "type": "string",
                "minLength": 2
              },
              "wardrobe": {
                "type": "string",
                "minLength": 2
              },
              "hair": {
                "type": "string",
                "minLength": 2
              },
              "physical_continuity": {
                "type": "string",
                "minLength": 2
              },
              "behavioural_continuity": {
                "type": "string",
                "minLength": 2
              }
            },
            "additionalProperties": false
          }
        },
        "set_card": {
          "type": "object",
          "required": [
            "location",
            "architecture",
            "materials",
            "furniture",
            "objects",
            "spatial_continuity"
          ],
          "properties": {
            "location": {
              "type": "string",
              "minLength": 2
            },
            "architecture": {
              "type": "string",
              "minLength": 2
            },
            "materials": {
              "type": "string",
              "minLength": 2
            },
            "furniture": {
              "type": "string",
              "minLength": 2
            },
            "objects": {
              "type": "string",
              "minLength": 2
            },
            "spatial_continuity": {
              "type": "string",
              "minLength": 2
            }
          },
          "additionalProperties": false
        },
        "lighting_card": {
          "type": "object",
          "required": [
            "key_light",
            "fill",
            "practical_sources",
            "time_of_day",
            "contrast",
            "colour_temperature"
          ],
          "properties": {
            "key_light": {
              "type": "string",
              "minLength": 2
            },
            "fill": {
              "type": "string",
              "minLength": 2
            },
            "practical_sources": {
              "type": "string",
              "minLength": 2
            },
            "time_of_day": {
              "type": "string",
              "minLength": 2
            },
            "contrast": {
              "type": "string",
              "minLength": 2
            },
            "colour_temperature": {
              "type": "string",
              "minLength": 2
            }
          },
          "additionalProperties": false
        },
        "colour_grade_card": {
          "type": "object",
          "required": [
            "base_palette",
            "accent_colours",
            "contrast",
            "saturation",
            "highlight_shadow_treatment"
          ],
          "properties": {
            "base_palette": {
              "type": "string",
              "minLength": 2
            },
            "accent_colours": {
              "type": "string",
              "minLength": 2
            },
            "contrast": {
              "type": "string",
              "minLength": 2
            },
            "saturation": {
              "type": "string",
              "minLength": 2
            },
            "highlight_shadow_treatment": {
              "type": "string",
              "minLength": 2
            }
          },
          "additionalProperties": false
        },
        "camera_language_card": {
          "type": "object",
          "required": [
            "shot_philosophy",
            "lens_tendencies",
            "camera_height",
            "movement_language",
            "framing",
            "depth_of_field"
          ],
          "properties": {
            "shot_philosophy": {
              "type": "string",
              "minLength": 2
            },
            "lens_tendencies": {
              "type": "string",
              "minLength": 2
            },
            "camera_height": {
              "type": "string",
              "minLength": 2
            },
            "movement_language": {
              "type": "string",
              "minLength": 2
            },
            "framing": {
              "type": "string",
              "minLength": 2
            },
            "depth_of_field": {
              "type": "string",
              "minLength": 2
            }
          },
          "additionalProperties": false
        },
        "product_card": {
          "type": "object",
          "required": [
            "product_identity",
            "material_appearance",
            "finish",
            "colour",
            "physical_characteristics",
            "approved_visual_behaviour"
          ],
          "properties": {
            "product_identity": {
              "type": "string",
              "minLength": 2
            },
            "material_appearance": {
              "type": "string",
              "minLength": 2
            },
            "finish": {
              "type": "string",
              "minLength": 2
            },
            "colour": {
              "type": "string",
              "minLength": 2
            },
            "physical_characteristics": {
              "type": "string",
              "minLength": 2
            },
            "approved_visual_behaviour": {
              "type": "string",
              "minLength": 2
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_number",
          "duration_seconds",
          "entry_keyframe",
          "key_moment_keyframe",
          "exit_keyframe",
          "transition_to_next"
        ],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "duration_seconds": {
            "type": "integer"
          },
          "entry_keyframe": {
            "$ref": "#/definitions/keyframe"
          },
          "key_moment_keyframe": {
            "$ref": "#/definitions/keyframe"
          },
          "exit_keyframe": {
            "$ref": "#/definitions/keyframe"
          },
          "transition_to_next": {
            "type": "string",
            "minLength": 2,
            "description": "How this scene's exit frame hands over. For the final scene, how the film ends."
          }
        },
        "additionalProperties": false
      }
    },
    "product_moment": {
      "type": "object",
      "required": [
        "product",
        "scene_number",
        "moment",
        "visual_treatment",
        "camera_emphasis",
        "physical_interaction",
        "product_truth_demonstrated"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 2
        },
        "moment": {
          "type": "string",
          "minLength": 2
        },
        "visual_treatment": {
          "type": "string",
          "minLength": 2
        },
        "camera_emphasis": {
          "type": "string",
          "minLength": 2
        },
        "physical_interaction": {
          "type": "string",
          "minLength": 2
        },
        "product_truth_demonstrated": {
          "type": "string",
          "minLength": 2
        },
        "scene_number": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "Where the product is shown doing what the approved claims say. Show, not tell."
    },
    "sound_direction": {
      "type": "object",
      "required": [
        "music_mood",
        "ambient_sound",
        "sound_effects",
        "vo_relationship",
        "silence_opportunities",
        "sonic_progression"
      ],
      "properties": {
        "music_mood": {
          "type": "string",
          "minLength": 2
        },
        "ambient_sound": {
          "type": "string",
          "minLength": 2
        },
        "vo_relationship": {
          "type": "string",
          "minLength": 2
        },
        "silence_opportunities": {
          "type": "string",
          "minLength": 2
        },
        "sonic_progression": {
          "type": "string",
          "minLength": 2
        },
        "sound_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "High-level sound direction. The locked voice-over stays as it is."
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything the lookbook had to assume or could not take from approved material. Shown to the reviewer."
    }
  },
  "definitions": {
    "keyframe": {
      "type": "object",
      "required": [
        "subject",
        "action_state",
        "environment",
        "composition",
        "camera_position",
        "lens",
        "lighting",
        "materials",
        "colour",
        "depth",
        "realism",
        "continuity_constraints"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 2,
          "description": "Who or what the frame is about."
        },
        "action_state": {
          "type": "string",
          "minLength": 2,
          "description": "What is happening, or the state things are in, at this instant."
        },
        "environment": {
          "type": "string",
          "minLength": 2
        },
        "composition": {
          "type": "string",
          "minLength": 2,
          "description": "Where things sit in the frame."
        },
        "camera_position": {
          "type": "string",
          "minLength": 2
        },
        "lens": {
          "type": "string",
          "minLength": 2
        },
        "lighting": {
          "type": "string",
          "minLength": 2
        },
        "materials": {
          "type": "string",
          "minLength": 2
        },
        "colour": {
          "type": "string",
          "minLength": 2
        },
        "depth": {
          "type": "string",
          "minLength": 2
        },
        "realism": {
          "type": "string",
          "minLength": 2,
          "description": "The physical detail that makes it look shot, not generated."
        },
        "continuity_constraints": {
          "type": "string",
          "minLength": 2,
          "description": "What must match the Continuity Bible and the neighbouring frames."
        }
      },
      "additionalProperties": false,
      "description": "One conceptual keyframe, concrete enough for an image model to reproduce it. No text inside the frame (Rule 2.4)."
    }
  },
  "additionalProperties": false
}
