{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script",
  "description": "Script contract v3. Additive over v2 (schemas/v2/). Adds the Magppie Video Production Rules structures: continuity_bible (Rule 3.4), per-scene directions (Rule 1), timed beats (Rule 1), and entry/exit frames (Rule 3.1). New fields stay optional so scripts locked under v1/v2 keep validating; workflows/continuity_gate.py enforces them for new runs.",
  "type": "object",
  "required": [
    "script_id",
    "request_id",
    "title",
    "format",
    "target_duration_seconds",
    "estimated_duration_seconds",
    "total_word_count",
    "hook",
    "scenes",
    "call_to_action",
    "self_critique_log"
  ],
  "definitions": {
    "angle_family": {
      "type": "string",
      "description": "What the piece is actually arguing. See knowledge/references/angle-taxonomy.md.",
      "enum": [
        "hygiene-biology",
        "acoustic-comfort",
        "thermal-durability",
        "material-longevity",
        "air-quality",
        "ergonomic-flow",
        "metallurgy-history",
        "craft-geometry-history",
        "lifecycle-sustainability"
      ]
    },
    "opening_form": {
      "type": "string",
      "description": "How the piece starts. See knowledge/references/angle-taxonomy.md.",
      "enum": [
        "everyday-friction",
        "sensory-detail",
        "material-detail",
        "verified-stat",
        "demonstration",
        "contrast",
        "direct-statement",
        "historical-discovery"
      ]
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "wide",
        "medium",
        "close-up",
        "extreme-close-up",
        "macro",
        "over-the-shoulder",
        "insert",
        "aerial"
      ]
    },
    "camera_movement": {
      "type": "string",
      "enum": [
        "static",
        "slow push-in",
        "slow pull-out",
        "dolly",
        "handheld",
        "gimbal track",
        "crane",
        "tilt",
        "pan",
        "rack-focus",
        "orbit"
      ]
    },
    "beat": {
      "type": "object",
      "description": "One timed unit inside a 30-second scene (Rule 1).",
      "required": [
        "beat_number",
        "time_range",
        "action",
        "camera",
        "emotion"
      ],
      "properties": {
        "beat_number": {
          "type": "integer",
          "minimum": 1
        },
        "time_range": {
          "type": "string",
          "description": "Within-scene timing, e.g. '0:00-0:05'.",
          "pattern": "^\\d{1,2}:\\d{2}\\s*[-–]\\s*\\d{1,2}:\\d{2}$"
        },
        "action": {
          "type": "string",
          "description": "What physically happens, beat by beat."
        },
        "camera": {
          "type": "string",
          "description": "Shot and movement for this beat."
        },
        "emotion": {
          "type": "string",
          "description": "Visible behaviour, never a label. Not 'she is happy' but 'her smile starts in her eyes before it reaches her mouth'."
        },
        "narration": {
          "type": "string",
          "description": "VO spoken during this beat, if any."
        },
        "delivery": {
          "type": "string",
          "description": "How this beat's narration is said: pitch, the breath before it, the stressed word, the pause after it (Rule 6)."
        }
      },
      "additionalProperties": false
    },
    "scene_directions": {
      "type": "object",
      "description": "The Rule 1 direction table. Every field removes guesswork for the video AI or production crew.",
      "required": [
        "location",
        "characters",
        "action",
        "emotion",
        "shot_type",
        "camera_movement",
        "lens",
        "lighting",
        "colour_grade",
        "sound"
      ],
      "properties": {
        "location": {
          "type": "string",
          "description": "Exact place, time of day, season."
        },
        "characters": {
          "type": "string",
          "description": "Who is in frame, age range, wardrobe, continuity ID."
        },
        "action": {
          "type": "string"
        },
        "emotion": {
          "type": "string",
          "description": "Visible behaviour (Rule 2.1)."
        },
        "shot_type": {
          "$ref": "#/definitions/shot_type"
        },
        "camera_movement": {
          "$ref": "#/definitions/camera_movement"
        },
        "lens": {
          "type": "string",
          "description": "e.g. '35mm natural perspective'."
        },
        "lighting": {
          "type": "string",
          "description": "Source, direction, quality, colour temperature."
        },
        "colour_grade": {
          "type": "string"
        },
        "sound": {
          "type": "string",
          "description": "Ambient, music cue, or silence."
        }
      },
      "additionalProperties": false
    },
    "continuity_bible": {
      "type": "object",
      "description": "Written once per film and repeated word for word in every scene prompt (Rule 3.4). This is what keeps one continuous world.",
      "required": [
        "characters",
        "set_location",
        "lighting",
        "colour_grade",
        "camera_language",
        "product"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "continuity_id",
              "description"
            ],
            "properties": {
              "continuity_id": {
                "type": "string",
                "pattern": "^C\\d+$"
              },
              "description": {
                "type": "string",
                "description": "Age range, look, hair, wardrobe, accessories."
              }
            },
            "additionalProperties": false
          }
        },
        "set_location": {
          "type": "string",
          "description": "Materials, colours, key furniture, layout, windows."
        },
        "lighting": {
          "type": "string"
        },
        "colour_grade": {
          "type": "string"
        },
        "camera_language": {
          "type": "string",
          "description": "Lens family, movement style."
        },
        "product": {
          "type": "string",
          "description": "Exact Magppie product, finish, colour, placement."
        },
        "voice": {
          "type": "string",
          "description": "The one narrator for the whole film: who is speaking, age range, accent, timbre, energy, distance from the microphone (Rule 6.1)."
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "script_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "short-form",
        "mid-form",
        "long-form"
      ]
    },
    "target_duration_seconds": {
      "type": "integer"
    },
    "estimated_duration_seconds": {
      "type": "integer"
    },
    "total_word_count": {
      "type": "integer"
    },
    "hook": {
      "type": "object",
      "required": [
        "hook_text",
        "duration_seconds",
        "visual_cue"
      ],
      "properties": {
        "hook_text": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer"
        },
        "visual_cue": {
          "type": "string"
        },
        "angle_family": {
          "$ref": "#/definitions/angle_family"
        },
        "opening_form": {
          "$ref": "#/definitions/opening_form"
        }
      },
      "additionalProperties": false
    },
    "narrative_beats": {
      "type": "array",
      "description": "Flexible story structure. Order the beats to suit the evidence and duration; historical-context is optional and must not be used without supported evidence.",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "beat_role",
          "content"
        ],
        "properties": {
          "beat_role": {
            "type": "string",
            "enum": [
              "hook",
              "tension",
              "evidence",
              "mechanism",
              "modern-bridge",
              "magppie-translation",
              "payoff",
              "historical-context"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "narrative_arc": {
      "type": "object",
      "description": "DEPRECATED (v1). Retained so scripts locked under v1 keep validating. New output should use narrative_beats; nothing renders this object.",
      "properties": {
        "stage_1_ancient_wisdom": {
          "type": "string"
        },
        "stage_2_discovery_tension": {
          "type": "string"
        },
        "stage_3_scientific_decode": {
          "type": "string"
        },
        "stage_4_modern_tech_bridge": {
          "type": "string"
        },
        "stage_5_magppie_translation": {
          "type": "string"
        },
        "stage_6_better_living_payoff": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_number",
          "time_range",
          "visual_direction",
          "narration",
          "on_screen_text",
          "audio_cues"
        ],
        "properties": {
          "scene_number": {
            "type": "integer"
          },
          "time_range": {
            "type": "string"
          },
          "visual_direction": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "audio_cues": {
            "type": "string"
          },
          "directions": {
            "$ref": "#/definitions/scene_directions"
          },
          "beats": {
            "type": "array",
            "description": "Timed beats tiling the full 30 seconds without gaps (Rule 1).",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "$ref": "#/definitions/beat"
            }
          },
          "entry_frame": {
            "type": "string",
            "description": "The exact first frame of this scene (Rule 3.1)."
          },
          "exit_frame": {
            "type": "string",
            "description": "The exact last frame; becomes the next scene's entry frame."
          },
          "transition_to_next": {
            "type": "string",
            "description": "Allowed in-camera transition (Rule 3.2)."
          },
          "vo_word_count": {
            "type": "integer",
            "description": "70-75 for a full 30-second scene (Rule 4.3)."
          },
          "voice_direction": {
            "type": "object",
            "description": "How this scene's voice-over is spoken, so it sounds like a person talking and never read out (Rule 6).",
            "required": [
              "tone",
              "pace",
              "pauses",
              "emphasis"
            ],
            "properties": {
              "tone": {
                "type": "string",
                "description": "The feeling in the voice as something you can hear, never a label."
              },
              "pace": {
                "type": "string",
                "description": "The speed, and where it changes."
              },
              "pauses": {
                "type": "string",
                "description": "Where the breath and the silence fall."
              },
              "emphasis": {
                "type": "string",
                "description": "The few words that carry the stress."
              }
            },
            "additionalProperties": false
          }
        },
        "description": "A 30-second generation unit (Rule 4.1). Video platforms cap clips at 30s, so a 60s film is two scenes, 90s is three."
      }
    },
    "call_to_action": {
      "type": "object",
      "required": [
        "cta_text",
        "cta_type"
      ],
      "properties": {
        "cta_text": {
          "type": "string"
        },
        "cta_type": {
          "type": "string"
        }
      }
    },
    "self_critique_log": {
      "type": "object",
      "required": [
        "hook_evaluation",
        "factual_consistency_score",
        "brand_voice_compliance",
        "product_truth_check",
        "internal_revisions_made"
      ],
      "properties": {
        "hook_evaluation": {
          "type": "string"
        },
        "factual_consistency_score": {
          "type": "string"
        },
        "brand_voice_compliance": {
          "type": "string"
        },
        "product_truth_check": {
          "type": "string"
        },
        "internal_revisions_made": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hook_candidates_considered": {
          "type": "array",
          "description": "Makes SKILL.md's 'generate at least three candidates, then select' rule auditable instead of merely claimed.",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "hook_text",
              "angle_family",
              "opening_form",
              "rejected_because"
            ],
            "properties": {
              "hook_text": {
                "type": "string"
              },
              "angle_family": {
                "$ref": "#/definitions/angle_family"
              },
              "opening_form": {
                "$ref": "#/definitions/opening_form"
              },
              "rejected_because": {
                "type": "string",
                "description": "Why this candidate lost, or 'SELECTED' for the chosen one."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "continuity_bible": {
      "$ref": "#/definitions/continuity_bible"
    }
  },
  "additionalProperties": false
}
