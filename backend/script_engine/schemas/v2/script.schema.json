{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script",
  "description": "Script contract v2. Additive over v1 (preserved at schemas/v1/script.schema.json): narrative_beats replaces the fixed 6-stage arc, and the hook now carries its angle_family and opening_form. The new fields are not listed as required so that scripts locked under v1 keep validating; the pipeline enforces their presence on live generation via workflows/diversity_gate.py.",
  "type": "object",
  "required": [
    "script_id",
    "request_id",
    "title",
    "format",
    "target_duration_seconds",
    "estimated_duration_seconds",
    "total_word_count",
    "hook",
    "scenes",
    "call_to_action",
    "self_critique_log"
  ],
  "definitions": {
    "angle_family": {
      "type": "string",
      "description": "What the piece is actually arguing. See knowledge/references/angle-taxonomy.md.",
      "enum": [
        "hygiene-biology",
        "acoustic-comfort",
        "thermal-durability",
        "material-longevity",
        "air-quality",
        "ergonomic-flow",
        "metallurgy-history",
        "craft-geometry-history",
        "lifecycle-sustainability"
      ]
    },
    "opening_form": {
      "type": "string",
      "description": "How the piece starts. See knowledge/references/angle-taxonomy.md.",
      "enum": [
        "everyday-friction",
        "sensory-detail",
        "material-detail",
        "verified-stat",
        "demonstration",
        "contrast",
        "direct-statement",
        "historical-discovery"
      ]
    }
  },
  "properties": {
    "script_id": { "type": "string" },
    "request_id": { "type": "string" },
    "title": { "type": "string" },
    "format": {
      "type": "string",
      "enum": ["short-form", "mid-form", "long-form"]
    },
    "target_duration_seconds": { "type": "integer" },
    "estimated_duration_seconds": { "type": "integer" },
    "total_word_count": { "type": "integer" },
    "hook": {
      "type": "object",
      "required": ["hook_text", "duration_seconds", "visual_cue"],
      "properties": {
        "hook_text": { "type": "string" },
        "duration_seconds": { "type": "integer" },
        "visual_cue": { "type": "string" },
        "angle_family": { "$ref": "#/definitions/angle_family" },
        "opening_form": { "$ref": "#/definitions/opening_form" }
      },
      "additionalProperties": false
    },
    "narrative_beats": {
      "type": "array",
      "description": "Flexible story structure. Order the beats to suit the evidence and duration; historical-context is optional and must not be used without supported evidence.",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["beat_role", "content"],
        "properties": {
          "beat_role": {
            "type": "string",
            "enum": [
              "hook",
              "tension",
              "evidence",
              "mechanism",
              "modern-bridge",
              "magppie-translation",
              "payoff",
              "historical-context"
            ]
          },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "narrative_arc": {
      "type": "object",
      "description": "DEPRECATED (v1). Retained so scripts locked under v1 keep validating. New output should use narrative_beats; nothing renders this object.",
      "properties": {
        "stage_1_ancient_wisdom": { "type": "string" },
        "stage_2_discovery_tension": { "type": "string" },
        "stage_3_scientific_decode": { "type": "string" },
        "stage_4_modern_tech_bridge": { "type": "string" },
        "stage_5_magppie_translation": { "type": "string" },
        "stage_6_better_living_payoff": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_number", "time_range", "visual_direction", "narration", "on_screen_text", "audio_cues"],
        "properties": {
          "scene_number": { "type": "integer" },
          "time_range": { "type": "string" },
          "visual_direction": { "type": "string" },
          "narration": { "type": "string" },
          "on_screen_text": { "type": "string" },
          "audio_cues": { "type": "string" }
        }
      }
    },
    "call_to_action": {
      "type": "object",
      "required": ["cta_text", "cta_type"],
      "properties": {
        "cta_text": { "type": "string" },
        "cta_type": { "type": "string" }
      }
    },
    "self_critique_log": {
      "type": "object",
      "required": [
        "hook_evaluation",
        "factual_consistency_score",
        "brand_voice_compliance",
        "product_truth_check",
        "internal_revisions_made"
      ],
      "properties": {
        "hook_evaluation": { "type": "string" },
        "factual_consistency_score": { "type": "string" },
        "brand_voice_compliance": { "type": "string" },
        "product_truth_check": { "type": "string" },
        "internal_revisions_made": { "type": "array", "items": { "type": "string" } },
        "hook_candidates_considered": {
          "type": "array",
          "description": "Makes SKILL.md's 'generate at least three candidates, then select' rule auditable instead of merely claimed.",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["hook_text", "angle_family", "opening_form", "rejected_because"],
            "properties": {
              "hook_text": { "type": "string" },
              "angle_family": { "$ref": "#/definitions/angle_family" },
              "opening_form": { "$ref": "#/definitions/opening_form" },
              "rejected_because": {
                "type": "string",
                "description": "Why this candidate lost, or 'SELECTED' for the chosen one."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}
